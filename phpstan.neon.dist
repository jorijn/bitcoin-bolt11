# Level max without a baseline: 2.0 has no code from before PHPStan, so
# everything is held to the strictest level from the start.
parameters:
    level: max
    paths:
        - src
        - tests
        # Keeps the examples in step with the API they show.
        - examples
    # Analyse against the lowest supported PHP version, so PHPStan does not
    # accept anything that would break on PHP 8.3.
    phpVersion: 80300
