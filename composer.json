{
  "name": "jorijn/bitcoin-bolt11",
  "description": "Decode and verify Lightning Network payment requests in pure PHP: BOLT #11 invoices and BOLT #12 offers, invoice requests and invoices",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "bitcoin",
    "bolt11",
    "bolt12",
    "lightning-network",
    "invoice",
    "offer",
    "payment-request"
  ],
  "homepage": "https://github.com/Jorijn/bitcoin-bolt11/",
  "authors": [
    {
      "name": "Jorijn Schrijvershof",
      "email": "jorijn@jorijn.com",
      "homepage": "https://jorijn.com"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "prefer-stable": true,
  "minimum-stability": "stable",
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "Jorijn\\Bitcoin\\Bolt11\\": "src/Bolt11/",
      "Jorijn\\Bitcoin\\Bolt12\\": "src/Bolt12/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Jorijn\\Bitcoin\\Bolt11\\": "tests/Bolt11/",
      "Tests\\Jorijn\\Bitcoin\\Bolt12\\": "tests/Bolt12/"
    }
  },
  "require": {
    "php": "^8.3",
    "php-64bit": "*",
    "ext-gmp": "*"
  },
  "scripts": {
    "test": "phpunit",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "stan": "phpstan analyse --memory-limit=1G"
  }
}
